VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional: the Telegram bot username (without @) turns on approvals and linking via Telegram.
VITE_TELEGRAM_BOT=
# Optional: download links for the Android apps (a Google Drive share link works). Each shows a button under
# Lainnya → Tim & perangkat → Aplikasi Android, for the owner only; empty hides it. Baked in at build time: rebuild and deploy after changing.
VITE_POS_APK_URL=
VITE_STOK_APK_URL=
